<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.henfon.shop</groupId>
        <artifactId>shop-admin</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>shop-ai</artifactId>
    <name>shop-ai</name>
    <dependencies>
        <dependency>
            <groupId>com.henfon.shop</groupId>
            <artifactId>shop-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.henfon.shop</groupId>
            <artifactId>shop-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.henfon.shop</groupId>
            <artifactId>shop-catalog</artifactId>
        </dependency>
        <!-- 工具层的数据来源：订单、物流、售后在 shop-trade，优惠券在 shop-marketing。
             物流轨迹读 trade_order_logistics 即可，门户展示的也是这份同步后的数据，工具里
             再去实时调快递 100 只会拖慢对话并消耗外部配额。 -->
        <dependency>
            <groupId>com.henfon.shop</groupId>
            <artifactId>shop-trade</artifactId>
        </dependency>
        <!-- 只为会员头像的地址重签：member.avatar_url 存的是对象键，不经过 ImageReferenceResolver
             换发就是裂图。除此之外本模块不碰对象存储。 -->
        <dependency>
            <groupId>com.henfon.shop</groupId>
            <artifactId>shop-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.henfon.shop</groupId>
            <artifactId>shop-marketing</artifactId>
        </dependency>
        <!-- 百炼接入：一个 starter 同时提供 ChatModel、EmbeddingModel 与 RerankModel。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-qdrant</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
