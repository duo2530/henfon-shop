# 复制为 .env 后填写真实值；.env 已加入 Git 忽略，禁止提交敏感信息。
SHOP_MYSQL_USERNAME=henfon
SHOP_MYSQL_PASSWORD=change-me
SHOP_MYSQL_ROOT_PASSWORD=change-me-root
SHOP_REDIS_PASSWORD=change-me-redis
SHOP_JWT_SECRET=change-me-to-a-long-random-secret
MINIO_ACCESS_KEY=henfon-minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=shop
ROCKETMQ_NAME_SERVER=host.docker.internal:9876
# 开发机未启动 RocketMQ 时保持 false；启动 NameServer/Broker 后改为 true。
SHOP_ROCKETMQ_CONSUMER_ENABLED=false
SHOP_WECHAT_PAY_ENABLED=false
# 微信 V3 回调必须使用原始通知入口（不要填写旧 DTO 入口 /notify）。
SHOP_WECHAT_PAY_NOTIFY_URL=https://your-domain.example.com/api/wx/pay/notify/v3
SHOP_WECHAT_PAY_REFUND_NOTIFY_URL=https://your-domain.example.com/api/wx/pay/refund/notify/v3
# 快递100轨迹查询默认关闭；申请开发账号后填写客户号和密钥。
SHOP_KUAIDI100_ENABLED=false
SHOP_KUAIDI100_CUSTOMER=
SHOP_KUAIDI100_KEY=
# 业务邮件通知默认关闭；开启前填写 SMTP 主机、账号、授权码和发件人。
SHOP_EMAIL_NOTIFICATION_ENABLED=false
SHOP_MAIL_HOST=
SHOP_MAIL_PORT=587
SHOP_MAIL_USERNAME=
SHOP_MAIL_PASSWORD=
SHOP_EMAIL_FROM=
# AI 智能客服默认关闭；开启前需要百炼 API Key 与 Qdrant Cloud 连接信息。
SHOP_AI_ENABLED=false
SHOP_DASHSCOPE_API_KEY=
# 只填主机名，不带 https:// 与端口，例如 xxx.<region>.cloud.qdrant.io。
SHOP_QDRANT_HOST=
SHOP_QDRANT_PORT=6334
# database 级 API Key，不使用集群全域 key。
SHOP_QDRANT_API_KEY=
SHOP_QDRANT_USE_TLS=true
# 门户对话配额。分钟配额挡脚本，日配额挡把请求摊薄到整天里的慢速占用。
# 匿名访客按来源 IP 计，同一出口的访客会互相占用额度；登录会员按会员 ID 计。
SHOP_AI_LIMIT_ENABLED=true
SHOP_AI_LIMIT_MEMBER_PER_MINUTE=30
SHOP_AI_LIMIT_MEMBER_PER_DAY=500
SHOP_AI_LIMIT_ANONYMOUS_PER_MINUTE=10
SHOP_AI_LIMIT_ANONYMOUS_PER_DAY=100
